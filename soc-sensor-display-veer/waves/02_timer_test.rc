; Synopsys Verdi nWave Signal Configuration for 02_timer_test.rc
Magic 271485
Revision Verdi_T-2022.06

addGroup "1. Clock & Reset"
addSignal -h 15 /tb_apb_timer/PCLK
addSignal -h 15 /tb_apb_timer/PRESETn

addGroup "2. External Interrupt"
addSignal -h 15 /tb_apb_timer/timer_irq

addGroup "3. APB Bus"
addSignal -h 15 /tb_apb_timer/PSEL
addSignal -h 15 /tb_apb_timer/PENABLE
addSignal -h 15 /tb_apb_timer/PWRITE
addSignal -h 15 /tb_apb_timer/PADDR[31:0]
addSignal -h 15 /tb_apb_timer/PWDATA[31:0]
addSignal -h 15 /tb_apb_timer/PRDATA[31:0]

addGroup "4. Timer Internals"
addSignal -h 15 /tb_apb_timer/dut/count_reg[31:0]
addSignal -h 15 /tb_apb_timer/dut/reload_reg[31:0]
addSignal -h 15 /tb_apb_timer/dut/ctrl_reg[1:0]
addSignal -h 15 /tb_apb_timer/dut/irq_status
