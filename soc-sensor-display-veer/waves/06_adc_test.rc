; Synopsys Verdi nWave Signal Configuration for 06_adc_test.rc
Magic 271485
Revision Verdi_T-2022.06

addGroup "1. Clock & Reset"
addSignal -h 15 /tb_apb_adc/PCLK
addSignal -h 15 /tb_apb_adc/PRESETn

addGroup "2. External ADC & IRQ"
addSignal -h 15 /tb_apb_adc/adc_analog_in[11:0]
addSignal -h 15 /tb_apb_adc/adc_irq

addGroup "3. APB Bus"
addSignal -h 15 /tb_apb_adc/PSEL
addSignal -h 15 /tb_apb_adc/PENABLE
addSignal -h 15 /tb_apb_adc/PWRITE
addSignal -h 15 /tb_apb_adc/PADDR[31:0]
addSignal -h 15 /tb_apb_adc/PWDATA[31:0]
addSignal -h 15 /tb_apb_adc/PRDATA[31:0]

addGroup "4. ADC Internals"
addSignal -h 15 /tb_apb_adc/dut/converting
addSignal -h 15 /tb_apb_adc/dut/conv_cnt[3:0]
addSignal -h 15 /tb_apb_adc/dut/eoc_flag
addSignal -h 15 /tb_apb_adc/dut/result_reg[11:0]
