; Synopsys Verdi nWave Signal Configuration for 07_soc_top_wave.rc
Magic 271485
Revision Verdi_T-2022.06

addGroup "1. Clock & Reset"
addSignal -h 15 /tb_soc_top/clk
addSignal -h 15 /tb_soc_top/rst_n

addGroup "2. External SoC I/O"
addSignal -h 15 /tb_soc_top/uart_tx
addSignal -h 15 /tb_soc_top/seg_out[7:0]
addSignal -h 15 /tb_soc_top/digit_sel[3:0]
addSignal -h 15 /tb_soc_top/pwm_out
addSignal -h 15 /tb_soc_top/adc_analog_in[11:0]
addSignal -h 15 /tb_soc_top/adc_irq
addSignal -h 15 /tb_soc_top/timer_irq

addGroup "3. AHB-Lite System Bus"
addSignal -h 15 /tb_soc_top/haddr[31:0]
addSignal -h 15 /tb_soc_top/htrans[1:0]
addSignal -h 15 /tb_soc_top/hwrite
addSignal -h 15 /tb_soc_top/hwdata[31:0]
addSignal -h 15 /tb_soc_top/hrdata[31:0]
addSignal -h 15 /tb_soc_top/hready

addGroup "4. APB Bridge & Peripherals"
addSignal -h 15 /tb_soc_top/dut/paddr[31:0]
addSignal -h 15 /tb_soc_top/dut/psel
addSignal -h 15 /tb_soc_top/dut/penable
addSignal -h 15 /tb_soc_top/dut/pwrite
addSignal -h 15 /tb_soc_top/dut/pwdata[31:0]
addSignal -h 15 /tb_soc_top/dut/prdata[31:0]
