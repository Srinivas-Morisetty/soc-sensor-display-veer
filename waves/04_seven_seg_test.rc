; Synopsys Verdi nWave Signal Configuration for 04_seven_seg_test.rc
Magic 271485
Revision Verdi_T-2022.06

addGroup "1. Clock & Reset"
addSignal -h 15 /tb_apb_seven_seg/PCLK
addSignal -h 15 /tb_apb_seven_seg/PRESETn

addGroup "2. External 7-Seg Pins"
addSignal -h 15 /tb_apb_seven_seg/seg_out[7:0]
addSignal -h 15 /tb_apb_seven_seg/digit_sel[3:0]

addGroup "3. APB Bus"
addSignal -h 15 /tb_apb_seven_seg/PSEL
addSignal -h 15 /tb_apb_seven_seg/PENABLE
addSignal -h 15 /tb_apb_seven_seg/PWRITE
addSignal -h 15 /tb_apb_seven_seg/PADDR[31:0]
addSignal -h 15 /tb_apb_seven_seg/PWDATA[31:0]
addSignal -h 15 /tb_apb_seven_seg/PRDATA[31:0]

addGroup "4. 7-Seg Internals"
addSignal -h 15 /tb_apb_seven_seg/dut/ctrl_reg[2:0]
addSignal -h 15 /tb_apb_seven_seg/dut/active_digit[1:0]
addSignal -h 15 /tb_apb_seven_seg/dut/scan_cnt[15:0]
