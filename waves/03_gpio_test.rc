; Synopsys Verdi nWave Signal Configuration for 03_gpio_test.rc
Magic 271485
Revision Verdi_T-2022.06

addGroup "1. Clock & Reset"
addSignal -h 15 /tb_apb_gpio/PCLK
addSignal -h 15 /tb_apb_gpio/PRESETn

addGroup "2. External GPIO Pins"
addSignal -h 15 /tb_apb_gpio/gpio_in[31:0]
addSignal -h 15 /tb_apb_gpio/gpio_out[31:0]
addSignal -h 15 /tb_apb_gpio/gpio_oe[31:0]

addGroup "3. APB Bus"
addSignal -h 15 /tb_apb_gpio/PSEL
addSignal -h 15 /tb_apb_gpio/PENABLE
addSignal -h 15 /tb_apb_gpio/PWRITE
addSignal -h 15 /tb_apb_gpio/PADDR[31:0]
addSignal -h 15 /tb_apb_gpio/PWDATA[31:0]
addSignal -h 15 /tb_apb_gpio/PRDATA[31:0]

addGroup "4. GPIO Internals"
addSignal -h 15 /tb_apb_gpio/dut/data_out_reg[31:0]
addSignal -h 15 /tb_apb_gpio/dut/dir_reg[31:0]
