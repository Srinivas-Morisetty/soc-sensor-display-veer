; Synopsys Verdi nWave Signal Configuration for 01_uart_test.rc
Magic 271485
Revision Verdi_T-2022.06

addGroup "1. Clock & Reset"
addSignal -h 15 /tb_apb_uart/PCLK
addSignal -h 15 /tb_apb_uart/PRESETn

addGroup "2. External UART Pins"
addSignal -h 15 /tb_apb_uart/uart_tx
addSignal -h 15 /tb_apb_uart/uart_rx
addSignal -h 15 /tb_apb_uart/uart_irq

addGroup "3. APB Bus"
addSignal -h 15 /tb_apb_uart/PSEL
addSignal -h 15 /tb_apb_uart/PENABLE
addSignal -h 15 /tb_apb_uart/PWRITE
addSignal -h 15 /tb_apb_uart/PADDR[31:0]
addSignal -h 15 /tb_apb_uart/PWDATA[31:0]
addSignal -h 15 /tb_apb_uart/PRDATA[31:0]

addGroup "4. UART Internals"
addSignal -h 15 /tb_apb_uart/dut/bauddiv[15:0]
addSignal -h 15 /tb_apb_uart/dut/ctrl[1:0]
addSignal -h 15 /tb_apb_uart/dut/tx_cnt[4:0]
addSignal -h 15 /tb_apb_uart/dut/tx_busy
